{
  "datasets": [
    {
      "name": "98b333f0",
      "displayName": "Claim Count by Type",
      "queryLines": [
        "select\n",
        "  type,\n",
        "  count(severity) as claim_count\n",
        "from\n",
        "  smart_claims_dev.`03_gold`.claim_insights\n",
        "where\n",
        "  to_date(claim_date) > :start_date\n",
        "  and to_date(claim_date) < :end_date\n",
        "group by\n",
        "  type"
      ],
      "parameters": [
        {
          "displayName": "start_date",
          "keyword": "start_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2015-01-01T00:00:00.000"
                }
              ]
            }
          }
        },
        {
          "displayName": "end_date",
          "keyword": "end_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-08-16T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "294be7b1",
