    {
      "name": "e932870b",
      "displayName": "Claim - driverAge",
      "queryLines": [
        "select\n",
        "  age as driver_age,\n",
        "  count(*) as count\n",
        "from\n",
        "  `smart_claims_dev`.`03_gold`.claim_insights\n",
        "where\n",
        "  age >= 14\n",
        "  and age < 110\n",
        "GROUP BY\n",
        "  age\n",
        "order by\n",
        "  age"
      ]
    },
