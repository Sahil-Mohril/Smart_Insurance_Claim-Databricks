    {
      "name": "ce8a3ca1",
      "displayName": "Claim - vehicleAge",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS count,\n",
        "  make,\n",
        "  model_year\n",
        "FROM\n",
        "  `smart_claims_dev`.`03_gold`.claim_insights\n",
        "GROUP BY\n",
        "  make,\n",
        "  model_year"
      ]
    },
    {
      "name": "eac405b3",
      "displayName": "Claims - Frequency by Hour",
      "queryLines": [
        "SELECT\n",
        "  hour as incident_hour,\n",
        "  COUNT(*) AS incidents,\n",
        "  SUM(injury) AS liability_amount,\n",
        "  SUM(property) + SUM(vehicle) AS property_amount\n",
        "FROM\n",
        "  `smart_claims_dev`.`03_gold`.claim_insights\n",
        "GROUP BY\n",
        "  hour\n",
        "ORDER BY\n",
        "  hour"
      ]
    },
    {
      "name": "4ed9ef43",
      "displayName": "Claims - Summary",
      "queryLines": [
        "SELECT\n",
        "  type as incident_type,\n",
        "  severity as incident_severity,\n",
        "  COUNT(severity) as count_severity\n",
        "FROM\n",
        "  `smart_claims_dev`.`03_gold`.claim_insights\n",
        "WHERE\n",
        "  to_date(claim_date) > :start_date\n",
        "  AND to_date(claim_date) < :end_date\n",
        "GROUP BY\n",
        "  type,\n",
        "  severity"
      ],
      "parameters": [
        {
          "displayName": "start_date",
          "keyword": "start_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2015-01-01"
                }
              ]
            }
          }
