    {
      "name": "eb80eff8",
      "displayName": "Claims - Damage - Property vs Liability vs Event Type",
      "queryLines": [
        "select\n",
        "  'liability damage' as type,\n",
        "  type as incident_type,\n",
        "  sum(injury) as amount\n",
        "from\n",
        "  `smart_claims_dev`.`03_gold`.claim_insights\n",
        "where\n",
        "  to_date(claim_date) >= :start_date\n",
        "  and to_date(claim_date) <= :end_date\n",
        "group by\n",
        "  type\n",
        "UNION\n",
        "select\n",
        "  'property damage' as type,\n",
        "  type as incident_type,\n",
        "  sum(property) + sum(vehicle) as amount\n",
        "from\n",
        "  `smart_claims_dev`.`03_gold`.claim_insights\n",
        "where\n",
        "  to_date(claim_date) >= :start_date\n",
        "  and to_date(claim_date) <= :end_date\n",
        "group by\n",
        "  type"
      ],
      "parameters": [
        {
          "displayName": "start_date",
          "keyword": "start_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2015-01-01"
                }
              ]
            }
          }
        },
        {
